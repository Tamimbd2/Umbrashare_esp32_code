#include <WiFi.h>
#include <Firebase_ESP_Client.h>

// WiFi credentials
#define WIFI_SSID "Alamin"
#define WIFI_PASSWORD "01788392063"

// Firebase config
#define API_KEY "AIzaSyBntis9XQeLCtPA5vDCr30XenhGIAPO-5c"
#define DATABASE_URL "https://ledproject-esp-default-rtdb.firebaseio.com/"

// Pins
#define IR_PIN 33
#define RELAY_PIN 25

// Firebase objects
FirebaseData fbdo;
FirebaseAuth auth;
FirebaseConfig config;

void setup() {
  Serial.begin(115200);

  pinMode(IR_PIN, INPUT);
  pinMode(RELAY_PIN, OUTPUT);

  // Relay OFF initially (Active LOW)
  digitalWrite(RELAY_PIN, HIGH);

  // WiFi connect
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  Serial.print("Connecting to WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    Serial.print(".");
    delay(500);
  }
  Serial.println("\nWiFi Connected");

  // Firebase config
  config.api_key = API_KEY;
  config.database_url = DATABASE_URL;

  // Anonymous sign-in
  Firebase.signUp(&config, &auth, "", "");
  Firebase.begin(&config, &auth);
  Firebase.reconnectWiFi(true);

  Serial.println("Firebase Connected");
}

void loop() {

  /* ---------- IR SENSOR → FIREBASE ---------- */
  int irState = digitalRead(IR_PIN);

  if (irState == HIGH) {
    Firebase.RTDB.setString(&fbdo, "/ir_status", "empty");
    Serial.println("IR HIGH → Empty");
  } else {
    Firebase.RTDB.setString(&fbdo, "/ir_status", "available");
    Serial.println("IR LOW → Available");
  }

  /* ---------- FIREBASE → RELAY CONTROL ---------- */
  if (Firebase.RTDB.getBool(&fbdo, "/relay_control")) {
    bool relayCmd = fbdo.boolData();

    if (relayCmd) {
      digitalWrite(RELAY_PIN, LOW);   // Relay ON
      Firebase.RTDB.setString(&fbdo, "/lock_status", "unlock");
      Serial.println("Relay ON → UNLOCK");
    } else {
      digitalWrite(RELAY_PIN, HIGH);  // Relay OFF
      Firebase.RTDB.setString(&fbdo, "/lock_status", "lock");
      Serial.println("Relay OFF → LOCK");
    }
  }

  delay(500);
}
